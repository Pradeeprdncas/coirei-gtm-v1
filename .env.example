# ============================================================
# Coirei — single .env for all three services:
#   • Main API (port 8000)       reads UPPERCASE keys via pydantic-settings
#   • Competitor API + worker    same pydantic-settings class (8001)
#   • GTM Crawler API + worker   reads GTM__SECTION__KEY overrides (8002)
#
# You only fill in the values in THIS file. start.sh / start.bat derive every
# GTM__* override the crawler needs (database URL, service token, LLM keys)
# from the plain keys below, so nothing is duplicated and nothing can drift.
# Running the crawler's own commands directly (gtm-api / gtm-worker without
# the start scripts) still needs GTM__* set manually — see the bottom section.
# ============================================================

# --- Shared database -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coirei_mvp

# --- Main / Competitor API --------------------------------------------------
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS_BEFORE_RUNNING
JWT_EXPIRE_MINUTES=1440
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_OPTIONAL=true
SCRAPE_MAX_PAGES=12
SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_BYTES=2000000

# --- LLM providers (used by every service: gap questions, product/competitor
# extraction, and the GTM crawler's page reading + company profile) ---------
# PRIMARY — Groq (OpenAI-compatible). Tried first everywhere.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# SECONDARY — fallback, tried only if the primary call fails. Local or cloud
# Ollama. Local:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_API_KEY=
# Cloud:
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_API_KEY=YOUR_OLLAMA_CLOUD_KEY

# --- Competitor discovery ----------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
COMPETITOR_SEARCH_PROVIDER=tavily
COMPETITOR_INTERNAL_URL=http://127.0.0.1:8001
COMPETITOR_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
COMPETITOR_MAX_QUERIES=5
COMPETITOR_MAX_CANDIDATES=10
COMPETITOR_MAX_PAGES=4

# --- GTM Crawler service ------------------------------------------------------
CRAWLER_BASE_URL=http://127.0.0.1:8002
CRAWLER_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ============================================================
# Manual GTM__SECTION__KEY overrides. ONLY needed if you run
# `gtm-api` / `gtm-worker` yourself, outside start.sh / start.bat — those
# scripts set all of these for you from the keys above.
# ============================================================
# GTM__DATABASE__URL=postgresql+psycopg://postgres:password@localhost:5432/coirei_mvp
# GTM__API__TOKEN=<same value as CRAWLER_SERVICE_TOKEN>
# GTM__LLM__BASE_URL=<same value as GROQ_BASE_URL>
# GTM__LLM__MODEL=<same value as GROQ_MODEL>
# GTM__LLM__API_KEY=<same value as GROQ_API_KEY>
# GTM__LLM__SECONDARY_BASE_URL=<OLLAMA_BASE_URL with /api replaced by /v1>
# GTM__LLM__SECONDARY_MODEL=<same value as OLLAMA_MODEL>
# GTM__LLM__SECONDARY_API_KEY=<same value as OLLAMA_API_KEY>
