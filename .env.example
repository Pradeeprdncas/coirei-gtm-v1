# Create an empty Postgres DB in Neon/Supabase and enable the vector extension.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coirei_mvp
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS_BEFORE_RUNNING
JWT_EXPIRE_MINUTES=1440
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Choose local or cloud; only configure secrets server-side.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_API_KEY=fbc290ff9b614ccfb477a8b7e29e09bf.pzH56kARexqXuSzF5QSw_khC
# Cloud alternative: https://ollama.com/api and an available cloud model + key.
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_MODEL=your-cloud-model
# OLLAMA_API_KEY=...
# Leave true to fall back to evidence-only deterministic extraction if the LLM is unavailable.
LLM_OPTIONAL=true
SCRAPE_MAX_PAGES=12
SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_BYTES=2000000

TAVILY_API_KEY=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
BRAVE_API_KEY=

COMPETITOR_SEARCH_PROVIDER=tavily

COMPETITOR_INTERNAL_URL=http://127.0.0.1:8001
COMPETITOR_INTERNAL_TOKEN=CbRb5rEG-Fhb2GHS8oXmtiF04uEx6OT3N8Et1KLk51BlzGRNmjI_KmcN12Qwm-2l

COMPETITOR_MAX_QUERIES=5
COMPETITOR_MAX_CANDIDATES=10
COMPETITOR_MAX_PAGES=4
