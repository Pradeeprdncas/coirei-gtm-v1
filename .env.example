# ============================================================
# Coirei — single .env for all three services:
#   • Main API (port 8000)   reads UPPERCASE keys via pydantic-settings
#   • Competitor API (8001)  same pydantic-settings class
#   • GTM Crawler (8002)     reads GTM__SECTION__KEY overrides; also picks up
#                             GROQ_* keys automatically from this file
# ============================================================

# --- Shared database -----------------------------------------
# Main/Competitor API use asyncpg; GTM Crawler uses psycopg (sync driver).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coirei_mvp
GTM__DATABASE__URL=postgresql+psycopg://postgres:password@localhost:5432/coirei_mvp

# --- Main / Competitor API -----------------------------------
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS_BEFORE_RUNNING
JWT_EXPIRE_MINUTES=1440
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider for gap-question generation (local Ollama or cloud).
# Local:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_API_KEY=
# Cloud:
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_API_KEY=YOUR_OLLAMA_CLOUD_KEY

LLM_OPTIONAL=true
SCRAPE_MAX_PAGES=12
SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_BYTES=2000000

TAVILY_API_KEY=
BRAVE_API_KEY=

COMPETITOR_SEARCH_PROVIDER=tavily

COMPETITOR_INTERNAL_URL=http://127.0.0.1:8001
COMPETITOR_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

COMPETITOR_MAX_QUERIES=5
COMPETITOR_MAX_CANDIDATES=10
COMPETITOR_MAX_PAGES=4

CRAWLER_BASE_URL=http://127.0.0.1:8002
CRAWLER_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Groq API (GTM Crawler LLM extraction) -------------------
# GROQ_API_KEY is read by both the main API (settings().groq_api_key) and
# automatically forwarded to the GTM Crawler as GTM__LLM__API_KEY.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- GTM Crawler overrides (GTM__SECTION__KEY) ---------------
# Shared token — must match CRAWLER_SERVICE_TOKEN above.
GTM__API__TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# LLM keys are auto-mapped from GROQ_* above; uncomment only to use a
# different provider for the crawler than for the main API.
# GTM__LLM__BASE_URL=https://api.groq.com/openai/v1
# GTM__LLM__MODEL=openai/gpt-oss-20b
# GTM__LLM__API_KEY=
